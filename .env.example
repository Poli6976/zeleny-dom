# Скопируй этот файл в .env и заполни ТОЛЬКО если используешь AI-генерацию статей.
# Файл .env в git не попадает (см. .gitignore) — ключи остаются у тебя на машине.

# Ключ Claude API для авто-написания статей (scripts/generate-articles.mjs).
# Получить: https://console.anthropic.com/  (это платный сервис — включать по желанию).
ANTHROPIC_API_KEY=

# Сколько статей генерировать за один запуск генератора.
GENERATE_BATCH_SIZE=3

# Токен Яндекс.Метрики для scripts/fetch-search-queries.mjs — читает запросы,
# по которым поиск на сайте ничего не нашёл (это очередь тем для новых статей).
# Получить: https://oauth.yandex.ru/ → приложение с правом
# «Яндекс.Метрика: получение статистики» (метрика:read).
# Только чтение статистики, менять счётчик этим токеном нельзя.
METRIKA_TOKEN=

# Номер счётчика. Пусто = берётся 110844315 (rasti-doma.ru).
METRIKA_COUNTER_ID=
