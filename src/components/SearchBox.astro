---
import { ANALYTICS } from '../site.config.mjs';

/**
 * Поиск по статьям на главной странице.
 *
 * Индекс (/search-index.json) грузится лениво — при первом фокусе на поле,
 * чтобы не тормозить первую отрисовку главной.
 *
 * Если по запросу ничего не нашлось, запрос уходит целью `search_no_results`
 * в Яндекс.Метрику. Это и есть список тем, которых на сайте не хватает:
 * смотреть в отчёте «Целевая аудитория → Достижение целей».
 */
---

<div class="search" data-metrika={ANALYTICS.yaMetrikaId}>
  <label class="search-label" for="site-search">Что ищете?</label>
  <div class="search-field">
    <input
      id="site-search"
      type="search"
      autocomplete="off"
      placeholder="Например: орхидея, тля, когда убирать чеснок"
      aria-describedby="search-hint"
    />
    <!-- Стрелка нарисована в SVG, а не символом шрифта: так она выглядит
         одинаково на любой системе и не рискует стать «квадратиком». -->
    <button type="button" class="search-submit" aria-label="Найти">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M4 12h14M12 6l6 6-6 6"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>
  </div>
  <p class="search-hint" id="search-hint">
    Ищем по названиям растений, вредителям и работам в саду
  </p>
  <div class="search-results" hidden></div>
</div>

<style>
  .search {
    max-width: 560px;
    margin: 28px auto 0;
    text-align: left;
    position: relative;
  }
  .search-label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-soft);
    margin-bottom: 8px;
    text-align: center;
  }
  .search-field {
    position: relative;
  }
  .search-field input {
    width: 100%;
    box-sizing: border-box;
    font-family: inherit;
    font-size: 1.05rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    /* Справа оставляем место под кнопку со стрелкой. */
    padding: 14px 60px 14px 22px;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  /* Крестик очистки в Chrome налезает на кнопку — убираем его. */
  .search-field input::-webkit-search-cancel-button {
    display: none;
  }
  .search-submit {
    position: absolute;
    top: 50%;
    right: 6px;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--brand);
    /* surface — белый в светлой теме и тёмный в тёмной, поэтому стрелка
       остаётся контрастной на фоне --brand в обеих. */
    color: var(--surface);
    cursor: pointer;
    transition: background 0.15s ease, transform 0.1s ease;
  }
  .search-submit svg {
    width: 20px;
    height: 20px;
  }
  .search-submit:hover {
    background: var(--brand-dark);
  }
  .search-submit:focus-visible {
    outline: 2px solid var(--brand-dark);
    outline-offset: 2px;
  }
  /* Заметная реакция на нажатие — особенно важно на телефоне, где нет :hover. */
  .search-submit:active {
    transform: translateY(-50%) scale(0.9);
  }
  .search-field input::placeholder {
    color: var(--text-soft);
  }
  .search-field input:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-soft);
  }
  .search-hint {
    margin: 8px 0 0;
    font-size: 0.85rem;
    color: var(--text-soft);
    text-align: center;
  }

  .search-results {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% - 22px);
    z-index: 20;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    max-height: 340px;
    overflow-y: auto;
    padding: 6px;
  }
  .search-results[hidden] {
    display: none;
  }
  /*
   * Выдачу строит скрипт, а Astro вешает свои scope-атрибуты только на элементы
   * из разметки. Поэтому правила для созданных на лету узлов — через :global(),
   * иначе стили к ним просто не применяются (ловили в проде: строки слипались).
   */
  .search-results :global(a) {
    display: block;
    padding: 10px 14px;
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
  }
  .search-results :global(a:hover),
  .search-results :global(a:focus-visible) {
    background: var(--brand-soft);
    text-decoration: none;
  }
  .search-results :global(.r-title) {
    display: block;
    font-weight: 600;
    line-height: 1.35;
  }
  .search-results :global(.r-cat) {
    display: block;
    font-size: 0.82rem;
    color: var(--text-soft);
    margin-top: 2px;
  }
  .search-results :global(.search-empty) {
    margin: 0;
    padding: 14px;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text);
  }

  @media (max-width: 560px) {
    .search-field input {
      font-size: 1rem;
      /* Справа отступ сохраняем — под кнопкой со стрелкой. */
      padding: 12px 56px 12px 18px;
    }
  }
</style>

<script>
  const root = document.querySelector('.search');
  if (root) {
    const input = root.querySelector('input');
    const box = root.querySelector('.search-results');
    const submit = root.querySelector('.search-submit');
    const metrikaId = root.dataset.metrika;

    /** @type {Array<{t:string,d:string,k:string[],u:string,c:string}>|null} */
    let index = null;
    let loading = null;
    let reported = '';
    // Отчёт о ненайденном запросе шлём с задержкой: иначе на «бегония» уходят
    // четыре цели — «бего», «бегон», «бегони», «бегония», и статистика мусорная.
    // Три секунды — чтобы обрубки не появлялись даже при медленном наборе;
    // по кнопке со стрелкой запрос уходит сразу, без ожидания.
    let reportTimer = null;
    const REPORT_DELAY = 3000;
    const REPORT_MIN_LENGTH = 3;
    // После явной отправки нечего было найти — очищаем поле и на пару секунд
    // подменяем плейсхолдер, чтобы посетитель увидел: вопрос ушёл, а не завис.
    const defaultPlaceholder = input.placeholder;
    let placeholderTimer = null;
    function confirmSent() {
      input.value = '';
      input.placeholder = 'Вопрос отправлен — мы его учли';
      clearTimeout(placeholderTimer);
      placeholderTimer = setTimeout(() => {
        input.placeholder = defaultPlaceholder;
      }, 2500);
    }

    /** Приводит текст к виду, по которому сравниваем: без ё и лишних символов. */
    function normalize(s) {
      return String(s).toLowerCase().replace(/ё/g, 'е');
    }

    /**
     * Грубая замена морфологии: у длинных слов отбрасываем окончание.
     * «орхидеи», «орхидея», «орхидею» → «орхид», и все находят друг друга.
     */
    function stem(word) {
      return word.length >= 6 ? word.slice(0, 5) : word;
    }

    function words(s) {
      return normalize(s).split(/[^a-zа-я0-9]+/).filter(Boolean);
    }

    async function loadIndex() {
      if (index) return index;
      if (!loading) {
        loading = fetch('/search-index.json')
          .then((r) => (r.ok ? r.json() : []))
          .then((data) => {
            index = data.map((item) => ({
              ...item,
              // Заранее считаем строки для поиска, чтобы не делать это на каждый ввод.
              _title: normalize(item.t),
              _keys: normalize((item.k || []).join(' ')),
              _text: normalize(`${item.t} ${item.d} ${(item.k || []).join(' ')}`),
            }));
            return index;
          })
          .catch(() => (index = []));
      }
      return loading;
    }

    /** Чем больше очков, тем выше статья в выдаче. 0 — не подходит. */
    function score(item, stems) {
      let total = 0;
      for (const s of stems) {
        if (item._title.includes(s)) total += 10;
        else if (item._keys.includes(s)) total += 6;
        else if (item._text.includes(s)) total += 2;
        else return 0; // нашлись не все слова запроса — статья не подходит
      }
      return total;
    }

    function clear() {
      while (box.firstChild) box.removeChild(box.firstChild);
    }

    function renderResults(list) {
      clear();
      for (const item of list) {
        const a = document.createElement('a');
        a.href = item.u;
        const title = document.createElement('span');
        title.className = 'r-title';
        title.textContent = item.t; // textContent, а не innerHTML — данные в разметку не попадают
        const cat = document.createElement('span');
        cat.className = 'r-cat';
        cat.textContent = item.c;
        a.append(title, cat);
        box.append(a);
      }
      box.hidden = false;
    }

    /** Отправляет ненайденный запрос в Метрику — один раз на запрос. */
    function report(query) {
      if (!metrikaId || query.length < REPORT_MIN_LENGTH || query === reported) return;
      reported = query;
      if (typeof window.ym === 'function') {
        window.ym(metrikaId, 'reachGoal', 'search_no_results', { query });
      }
    }

    /**
     * Ничего не нашли — говорим об этом читателю и записываем запрос.
     * При наборе отправку откладываем, чтобы не слать обрывки слова;
     * если человек нажал стрелку, запрос уходит немедленно.
     */
    function renderEmpty(query, immediate) {
      clear();
      const p = document.createElement('p');
      p.className = 'search-empty';
      p.textContent = 'Такой статьи пока нет — мы записали ваш запрос и напишем материал по этой теме.';
      box.append(p);
      box.hidden = false;

      if (immediate) {
        report(query);
        confirmSent();
      } else {
        reportTimer = setTimeout(() => report(query), REPORT_DELAY);
      }
    }

    async function run(immediate = false) {
      // Любой новый символ отменяет отложенную отправку — уходит только то,
      // на чём человек остановился.
      clearTimeout(reportTimer);
      const query = input.value.trim();
      if (query.length < 2) {
        box.hidden = true;
        return;
      }
      const data = await loadIndex();
      const stems = words(query).map(stem);
      if (!stems.length) {
        box.hidden = true;
        return;
      }
      const found = data
        .map((item) => ({ item, s: score(item, stems) }))
        .filter((x) => x.s > 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, 6)
        .map((x) => x.item);

      if (found.length) renderResults(found);
      else renderEmpty(normalize(query), immediate);
    }

    input.addEventListener('focus', loadIndex, { once: true });
    input.addEventListener('input', () => run());

    // Кнопка со стрелкой — явная отправка: результат показываем сразу
    // и, если ничего не нашлось, сразу записываем запрос.
    submit.addEventListener('click', () => {
      run(true);
      input.focus();
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        box.hidden = true;
        input.blur();
      }
      if (e.key === 'Enter') {
        e.preventDefault();
        const first = box.querySelector('a');
        // Есть выдача — переходим к первой статье, нет — это тоже явная
        // отправка, и запрос уходит сразу, как по кнопке.
        if (first && !box.hidden) window.location.href = first.href;
        else run(true);
      }
      if (e.key === 'ArrowDown' && !box.hidden) {
        const first = box.querySelector('a');
        if (first) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target)) box.hidden = true;
    });
  }
</script>
